// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id             String         @id @db.Uuid
  username       String
  created_at     DateTime       @default(now()) @db.Timestamptz
  update_at      DateTime       @default(now()) @updatedAt @db.Timestamptz
  image          String?
  writingEntries WritingEntry[]

  @@map("profile")
}

model WritingEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  title         String
  original_text String
  status        Boolean
  target        Target
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz

  profile Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  correctionRun CorrectionRun[]
  entryTag      EntryTag[]

  @@index([user_id, created_at])
  @@map("writing_entrie")
}

model CorrectionRun {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_id       String   @db.Uuid
  source_text    String
  corrected_text String
  created_at     DateTime @default(now()) @db.Timestamptz

  writingEntry WritingEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  correctionItem CorrectionItem[]
  question       Question[]

  @@index([entry_id, created_at])
  @@map("correction_run")
}

model CorrectionItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correction_run_id String   @db.Uuid
  category          Category
  original          String
  corrected         String
  explanation       String
  display_order     Int
  created_at        DateTime @default(now()) @db.Timestamptz

  correctionRun CorrectionRun @relation(fields: [correction_run_id], references: [id], onDelete: Cascade)

  @@index([correction_run_id, display_order])
  @@map("correction_item")
}

model Question {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correction_run_id String   @db.Uuid
  question_text     String
  created_at        DateTime @default(now()) @db.Timestamptz

  correctionRun CorrectionRun @relation(fields: [correction_run_id], references: [id], onDelete: Cascade)

  @@index([correction_run_id])
  @@map("question")
}

model Tag {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String

  entryTag EntryTag[]

  @@map("tag")
}

model EntryTag {
  entry_id String @map("entry_id") @db.Uuid
  tag_id   String @map("tag_id") @db.Uuid

  writingEntry WritingEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([entry_id, tag_id])
  @@index([entry_id])
  @@index([tag_id])
  @@map("entry_tag")
}

enum Target {
  A1
  A2
  B1
  B2
  C1
}

enum Category {
  grammar
  expression
  vocabulary
}
