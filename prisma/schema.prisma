generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String          @id @db.Uuid
  username      String
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  update_at     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  image         String?
  writing_entry writing_entry[]

  @@map("profile")
}

model CorrectionRun {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entry_id       String           @db.Uuid
  source_text    String
  corrected_text String
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  correctionItem CorrectionItem[]
  writingEntry   writing_entry    @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  question       Question[]

  @@index([entry_id, created_at])
  @@map("correction_run")
}

model CorrectionItem {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correction_run_id String        @db.Uuid
  category          Category
  original          String
  corrected         String
  explanation       String
  display_order     Int
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  correctionRun     CorrectionRun @relation(fields: [correction_run_id], references: [id], onDelete: Cascade)

  @@index([correction_run_id, display_order])
  @@map("correction_item")
}

model Question {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correction_run_id String        @db.Uuid
  question_text     String
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  correctionRun     CorrectionRun @relation(fields: [correction_run_id], references: [id], onDelete: Cascade)

  @@index([correction_run_id])
  @@map("question")
}

model Tag {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  entryTag EntryTag[]

  @@map("tag")
}

model EntryTag {
  entry_id     String        @map("entry_id") @db.Uuid
  tag_id       String        @map("tag_id") @db.Uuid
  writingEntry writing_entry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  tag          Tag           @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([entry_id, tag_id])
  @@index([entry_id])
  @@index([tag_id])
  @@map("entry_tag")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model writing_entry {
  id            String          @id(map: "writing_entry_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String          @db.Uuid
  original_text String
  status        Boolean?
  target        Target
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  correctionRun CorrectionRun[]
  entryTag      EntryTag[]
  profile       Profile         @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "writing_entry_user_id_fkey")

  @@index([user_id, created_at], map: "writing_entry_user_id_created_at_idx")
}

enum Target {
  A1
  A2
  B1
  B2
  C1
}

enum Category {
  grammar
  expression
  vocabulary
}
